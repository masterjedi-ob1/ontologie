{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": { "@onto/*": ["../src/ontology/*"] }
  },
  "include": ["src", "../src/ontology/engine.ts", "../src/ontology/seed.ts", "../src/ontology/types.ts", "../src/ontology/tokens.ts"]
}
